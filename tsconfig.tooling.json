{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "node_modules/.tsbuild/tooling",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "db/tests/**/*.ts",
    "netlify/tests/**/*.ts"
  ],
  "references": [
    {
      "path": "./packages/shared"
    },
    {
      "path": "./netlify"
    }
  ]
}
