# Copy to .env for local development. Never commit real values.
# Each variable lists WHERE it belongs. Functions never receive write credentials.

# ── Netlify Functions (set in Netlify: Site settings → Environment variables) ──────────────
# Neon connection string for the READ-ONLY role (see db/roles.sql). Used by netlify/functions.
DATABASE_URL_READ=postgresql://bla_reader:<password>@<host>.neon.tech/<db>?sslmode=require

# ── Pipelines only (local .env and GitHub Actions secrets; NOT in Netlify) ──────────────────
# Neon connection string for the WRITE role, used by `python -m pipelines ...`.
DATABASE_URL_WRITE=postgresql://bla_writer:<password>@<host>.neon.tech/<db>?sslmode=require
# Free UN Comtrade API key (https://comtradedeveloper.un.org/). Pipelines only.
COMTRADE_API_KEY=
# Manual World Gold Council XLSX import (data/source/wgc/). Keep false unless written
# permission from the WGC has been obtained.
ENABLE_WGC_IMPORT=false
# Optional: Netlify build hook URL; the data-refresh workflow calls it when data changes.
NETLIFY_BUILD_HOOK=
